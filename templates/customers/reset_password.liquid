<div class="ds-section ds-pt-lg ds-pb-lg">
  <div class="ds-container">
    <h1 class="ds-h1 ds-h1--page" style="color: var(--ds-ink); margin-bottom: 32px">
      {{ 'customer.reset_password.title' | t }}
    </h1>

    {%- form 'reset_customer_password', class: 'ds-form' -%}
      {{ form.errors | default_errors }}
      <label class="ds-field">
        <span class="ds-field__label">{{ 'customer.reset_password.password' | t }}</span>
        <input class="ds-input" type="password" name="customer[password]" autocomplete="new-password">
      </label>
      <label class="ds-field">
        <span class="ds-field__label">{{ 'customer.reset_password.password_confirm' | t }}</span>
        <input class="ds-input" type="password" name="customer[password_confirmation]" autocomplete="new-password">
      </label>
      <button type="submit" class="ds-btn ds-btn--purple">{{ 'customer.reset_password.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>
