<div class="ds-section ds-pt-lg ds-pb-lg">
  <div class="ds-container">
    <h1 class="ds-h1 ds-h1--page" style="color: var(--ds-ink); margin-bottom: 32px">{{ 'customer.login.title' | t }}</h1>

    {%- form 'customer_login', class: 'ds-form' -%}
      {{ form.errors | default_errors }}
      <label class="ds-field">
        <span class="ds-field__label">{{ 'customer.login.email' | t }}</span>
        <input class="ds-input" type="email" name="customer[email]" autocomplete="email" required>
      </label>
      <label class="ds-field">
        <span class="ds-field__label">{{ 'customer.login.password' | t }}</span>
        <input class="ds-input" type="password" name="customer[password]" autocomplete="current-password">
      </label>
      <button type="submit" class="ds-btn ds-btn--purple">{{ 'customer.login.sign_in' | t }}</button>
    {%- endform -%}

    <p class="ds-note"><a href="{{ routes.account_register_url }}">{{ 'customer.login.create_account' | t }}</a></p>
  </div>
</div>
