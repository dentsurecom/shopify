<div class="ds-section ds-pt-lg ds-pb-lg{% if section.settings.background == 'soft' %} ds-bg-soft{% endif %}{% if section.settings.reveal %} ds-reveal{% endif %}">
  <div class="ds-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="ds-h2 ds-h2--md" style="margin-bottom: 14px">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <p class="ds-body" style="margin-bottom: 56px">{{ section.settings.text }}</p>
    {%- endif -%}

    <div class="ds-timeline">
      {%- for block in section.blocks -%}
        {%- liquid
          assign has_media = false
          if block.settings.image != blank or block.settings.image_url != blank
            assign has_media = true
          endif
        -%}
        <div class="ds-timeline__step" {{ block.shopify_attributes }}>
          <div class="ds-timeline__media">
            {%- if has_media -%}
              {% render 'media-image',
                image: block.settings.image,
                fallback_url: block.settings.image_url,
                alt: block.settings.title,
                sizes: '(min-width: 990px) 25vw, (min-width: 480px) 50vw, 100vw'
              %}
            {%- else -%}
              <span class="ds-timeline__ghost" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            {%- endif -%}
            {%- if block.settings.show_play -%}
              <span class="ds-timeline__play" aria-hidden="true">&#9654;</span>
            {%- endif -%}
          </div>
          <div class="ds-timeline__label">{{ block.settings.label }}</div>
          <div class="ds-timeline__title">{{ block.settings.title }}</div>
          <p class="ds-timeline__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Timeline",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From scan to smile in four steps"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "soft", "label": "Soft lilac" }
      ],
      "default": "soft"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Step 1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Scan and order"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Capture a full arch with the Helios 700 and submit the case in the portal."
        },
        {
          "type": "header",
          "content": "Media"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Image URL",
          "info": "Used when no image is uploaded. Leave both empty for a numbered placeholder."
        },
        {
          "type": "checkbox",
          "id": "show_play",
          "label": "Show play button",
          "info": "Makes the frame read as a video placeholder.",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Timeline"
    }
  ]
}
{% endschema %}
