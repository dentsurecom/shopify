{%- liquid
  comment
    With a rule on top, the rule itself carries the spacing so it sits directly
    under the section above — as in the design.
  endcomment
  assign section_class = 'ds-section ds-pb-lg'
  unless section.settings.border_top
    assign section_class = section_class | append: ' ds-pt-lg'
  endunless
  if section.settings.background == 'soft'
    assign section_class = section_class | append: ' ds-bg-soft'
  endif

  assign grid_class = 'ds-cols'
  if section.settings.show_images == false
    assign grid_class = grid_class | append: ' ds-cols--plain'
  endif
  if section.settings.border_top
    assign grid_class = grid_class | append: ' ds-cols--ruled'
  endif
-%}

<div class="{{ section_class }}{% if section.settings.reveal %} ds-reveal{% endif %}">
  <div class="ds-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="ds-h2 ds-h2--md{% if section.settings.heading_align == 'center' %} ds-text-center{% endif %}"
        style="max-width: 760px; margin-bottom: 56px{% if section.settings.heading_align == 'center' %}; margin-inline: auto; text-align: center{% endif %}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    <div class="{{ grid_class }}" style="--ds-cols: {{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {%- if section.settings.show_images -%}
            <div class="ds-col__media">
              {% render 'media-image',
                image: block.settings.image,
                fallback_asset: block.settings.fallback_asset,
                fallback_url: block.settings.image_url,
                alt: block.settings.title,
                sizes: '(min-width: 990px) 33vw, 100vw'
              %}
            </div>
          {%- endif -%}

          {%- if block.settings.label != blank -%}
            {%- assign number = forloop.index | prepend: '0' | slice: -2, 2 -%}
            <div class="ds-col__label">{{ number }} · {{ block.settings.label }}</div>
          {%- endif -%}

          <div class="ds-col__title">{{ block.settings.title }}</div>
          <p class="ds-col__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Feature columns",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everything you — and your patient — need"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centred" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_images",
      "label": "Show images",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "Hairline rule above",
      "default": false
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "soft", "label": "Soft lilac" }
      ],
      "default": "white"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "fallback_asset",
          "label": "Fallback image file"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Fallback image URL"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Numbered automatically. Leave blank to hide."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Ortho support on every case"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature columns"
    }
  ]
}
{% endschema %}
