<div class="ds-section ds-pt-lg ds-pb-lg{% if section.settings.background == 'soft' %} ds-bg-soft{% endif %}{% if section.settings.reveal %} ds-reveal{% endif %}">
  <div class="ds-container">
    <div class="ds-faq">
      <h2 class="ds-h2 ds-h2--sm">{{ section.settings.heading }}</h2>

      {%- for block in section.blocks -%}
        <details class="ds-faq__item" {{ block.shopify_attributes }}>
          <summary class="ds-faq__q">
            <span>{{ block.settings.question }}</span>
            <span class="ds-faq__sign ds-faq__sign--plus" aria-hidden="true">+</span>
            <span class="ds-faq__sign ds-faq__sign--minus" aria-hidden="true">&ndash;</span>
          </summary>
          <div class="ds-faq__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "soft", "label": "Soft lilac" }
      ],
      "default": "white"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is a design preview?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ"
    }
  ]
}
{% endschema %}
