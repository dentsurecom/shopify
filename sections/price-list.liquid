<div class="ds-section ds-pt-lg{% if section.settings.padding_bottom %} ds-pb-lg{% endif %}{% if section.settings.reveal %} ds-reveal{% endif %}">
  <div class="ds-container">
    <div class="ds-pricehead">
      <h2 class="ds-h2 ds-h2--sm">{{ section.settings.heading }}</h2>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link | default: '#' }}" class="ds-link-arrow" style="font-size: 15px">
          {{ section.settings.link_label }} &rarr;
        </a>
      {%- endif -%}
    </div>

    <div class="ds-pricelist">
      {%- for block in section.blocks -%}
        <div class="ds-pricelist__row" {{ block.shopify_attributes }}>
          <span>{{ block.settings.label }}</span>
          <b>{{ block.settings.price }}</b>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.note != blank -%}
      <div class="ds-note">{{ section.settings.note }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Price list",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Crowns & Bridges"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Explore crowns"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note",
      "default": "Per unit · 5-day turnaround · lifetime warranty · free shipping both ways"
    },
    {
      "type": "checkbox",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Monolithic Zirconia (3Y)"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$89"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Price list"
    }
  ]
}
{% endschema %}
