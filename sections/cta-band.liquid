<div class="ds-cta{% if section.settings.layout == 'center' %} ds-cta--center{% endif %}{% if section.settings.reveal %} ds-reveal{% endif %}">
  <div class="ds-container ds-cta__inner">
    <div>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.show_form -%}
      {%- form 'customer', class: 'ds-cta__form' -%}
        <input type="hidden" name="contact[tags]" value="prospect,cta-signup">
        {%- if form.posted_successfully? -%}
          <p class="ds-cta__form-msg ds-cta__form-msg--ok">{{ section.settings.form_success }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <p class="ds-cta__form-msg ds-cta__form-msg--err">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          <div class="ds-cta__form-row">
            <input
              type="email"
              name="contact[email]"
              class="ds-cta__input"
              placeholder="{{ section.settings.form_placeholder | escape }}"
              aria-label="{{ section.settings.form_placeholder | escape }}"
              autocomplete="email"
              required
            >
            <button type="submit" class="ds-btn ds-btn--primary ds-btn--lg">
              {{ section.settings.form_button }}
            </button>
          </div>
        {%- endif -%}
      {%- endform -%}
    {%- elsif section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="ds-btn ds-btn--primary ds-btn--lg">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "CTA band",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "split", "label": "Heading left, button right" },
        { "value": "center", "label": "Centred" }
      ],
      "default": "split"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Make DentSure your last lab switch."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Book a demo"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Signup form",
      "info": "Replaces the button. Submissions appear in Shopify admin under Customers, tagged cta-signup."
    },
    {
      "type": "checkbox",
      "id": "show_form",
      "label": "Show email signup form",
      "default": false
    },
    {
      "type": "text",
      "id": "form_placeholder",
      "label": "Email placeholder",
      "default": "Work email"
    },
    {
      "type": "text",
      "id": "form_button",
      "label": "Form button label",
      "default": "Get started"
    },
    {
      "type": "text",
      "id": "form_success",
      "label": "Success message",
      "default": "Thanks — we'll be in touch shortly."
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "CTA band"
    }
  ]
}
{% endschema %}
