<div class="ds-cta{% if section.settings.layout == 'center' %} ds-cta--center{% endif %}{% if section.settings.reveal %} ds-reveal{% endif %}">
  <div class="ds-container ds-cta__inner">
    <div>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="ds-btn ds-btn--primary ds-btn--lg">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "CTA band",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "split", "label": "Heading left, button right" },
        { "value": "center", "label": "Centred" }
      ],
      "default": "split"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Make DentSure your last lab switch."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Book a demo"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "CTA band"
    }
  ]
}
{% endschema %}
