<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {{ content_for_header }}
    <style>
      :root {
        --ds-font-body: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --ds-font-heading: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
        --ds-purple: {{ settings.color_purple }};
        --ds-teal: {{ settings.color_teal }};
        --ds-ink: {{ settings.color_ink }};
        --ds-muted: {{ settings.color_muted }};
      }
    </style>
    {{ 'dentsure.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="template-password">
    <main class="ds-pagehero ds-section" style="min-height: 100vh; display: flex; align-items: center">
      <span class="ds-decor ds-decor--ring"></span>
      <span class="ds-decor ds-decor--disc"></span>
      <div class="ds-container" style="position: relative; text-align: center">
        {% render 'logo' %}
        <h1 class="ds-h1 ds-h1--page" style="color: #fff; margin: 32px 0 16px">{{ shop.name }}</h1>
        <p class="ds-pagehero__text" style="margin-inline: auto">{{ shop.description | default: 'Opening soon.' }}</p>
        <div style="max-width: 420px; margin: 32px auto 0">{{ content_for_layout }}</div>
      </div>
    </main>
  </body>
</html>
